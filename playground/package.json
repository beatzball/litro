{
  "name": "playground",
  "version": "0.0.44",
  "private": true,
  "description": "Litro playground — test app using the framework locally",
  "type": "module",
  "imports": {
    "#litro/page-manifest": "./server/stubs/page-manifest.ts",
    "#litro/action-manifest": "./server/stubs/action-manifest.ts",
    "#litro/agent-manifest": "./server/stubs/agent-manifest.ts",
    "#litro/agent-config": "./server/stubs/agent-config.ts"
  },
  "scripts": {
    "dev": "litro dev",
    "dev:portless": "portless run litro dev",
    "build": "litro build",
    "preview": "litro preview",
    "preview:portless": "portless run litro preview",
    "generate": "litro generate",
    "mcp-app": "litro mcp-app build",
    "test": "node --test \"mcp-server/*.test.ts\" && vitest run",
    "typecheck": "tsc -p mcp-server/tsconfig.json && tsc -p tests/tsconfig.json",
    "test:run-code:vm": "vitest run --config vitest.vm.config.ts"
  },
  "dependencies": {
    "@beatzball/litro": "workspace:*",
    "@beatzball/litro-agent": "workspace:^",
    "@beatzball/litro-native": "workspace:^",
    "lit": "^3.2.1",
    "@lit-labs/ssr": "^3.3.0",
    "@lit-labs/ssr-client": "^1.1.7",
    "h3": "^1.15.6",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.6",
    "@beatzball/sandpiper": "file:vendor/sandpiper"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "nitropack": "^2.13.4",
    "vite": "^8.1.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
