# Dependencies
node_modules/

# Build outputs
dist/
.output/
.nitro/

# Framework compiled output
packages/*/dist/

# Playground: Vite client bundle + Nitro server bundle
playground/dist/

# Generated files (overwritten on every build; contain machine-local absolute paths)
playground*/server/stubs/
playground*/routes.generated.ts

# Playwright
/test-results/
/playwright-report/
e2e/test-results/

# Nitro / Nuxt cache
.nitro/
.nuxt/

# TypeScript composite build info
*.tsbuildinfo

# OS / editor
.DS_Store
.env
.env.*
*.local
.vscode/settings.json

# Docs workspace generated files
docs/server/stubs/
docs/routes.generated.ts
docs-ssr/server/stubs/
docs-ssr/routes.generated.ts

# Benchmark apps: generated files and build outputs
benchmarks/apps/litro/server/stubs/
benchmarks/apps/litro/routes.generated.ts
benchmarks/apps/nuxt/node_modules/
benchmarks/apps/nuxt/.output/
benchmarks/apps/nuxt/.nuxt/
benchmarks/apps/nextjs/node_modules/
benchmarks/apps/nextjs/out/
benchmarks/apps/nextjs/.next/
# benchmarks/results/latest.json is intentionally tracked — docs pages read it at build time.
# Only ignore other result files (e.g. timestamped snapshots).
benchmarks/results/*.json
!benchmarks/results/latest.json

# Claude Code
.claude/
