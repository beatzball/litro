{
  "name": "@beatzball/litro-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx src/runner.ts",
    "bench:quick": "tsx src/runner.ts --skip-lighthouse",
    "bench:cross": "tsx src/runner.ts --cross-framework --skip-lighthouse",
    "bench:full": "tsx src/runner.ts --cross-framework",
    "bench:hn": "tsx src/runner.ts --hn --skip-lighthouse",
    "bench:hn:full": "tsx src/runner.ts --hn",
    "bench:all": "tsx src/runner.ts --cross-framework --hn --skip-lighthouse",
    "bench:all:full": "tsx src/runner.ts --cross-framework --hn",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.4.0",
    "serve": "^14.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
