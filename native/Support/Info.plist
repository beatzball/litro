<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both names come from the app.json of the selected app, through the xcconfig
	     that native/scripts/select-app.sh writes. Nothing per-app is typed here. -->
	<key>CFBundleDisplayName</key>
	<string>$(LITRO_APP_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The shell uses only the system HTTPS stack, which is exempt from export
	     reporting. Without this key App Store Connect asks the encryption
	     question on every upload. Write comments here without apostrophes:
	     this file runs through the C preprocessor (NATIVE-017). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- The scene life cycle, which UIKit requires of an app built with a
	     current SDK. Without this an app delegate owning a UIWindow directly
	     only logs a fault today, and is terminated on launch by the SDK that
	     enforces it.

	     The delegate class is named with $(PRODUCT_MODULE_NAME) rather than
	     spelled out, because the module name follows PRODUCT_NAME, which
	     select-app.sh writes per app. A literal prefix here would resolve for
	     one app and silently fail to load for the next one, and a scene
	     delegate that fails to load is a black window with no error. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- One window. The shell is one web view filling the screen, so there
		     is nothing a second scene would show. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Everything below is DEBUG ONLY, through the Info.plist preprocessor.
	     Shell.xcconfig defines LITRO_DEBUG_NETWORKING for the Debug
	     configuration and for no other.

	     A shipped Litro app starts at a public https URL and never touches the
	     local network, so it needs neither key. Leaving them in is not free:
	     Apple lists NSAllowsLocalNetworking among the App Transport Security
	     keys that require a written justification at App Store review, so
	     shipping it buys a reviewer question on every submission from every app
	     built on this shell, in exchange for nothing a shipped app uses.

	     In a Debug build both are needed. NSAllowsLocalNetworking permits the
	     plain http of a Litro dev server, and without the usage description
	     iOS 18 and later may never show the local network prompt at all and the
	     connection simply fails -- which is a 30 second black screen and no
	     explanation anywhere.

	     The broader NSAllowsArbitraryLoads is deliberately never used, in any
	     configuration: it allows plain http everywhere. -->
#if LITRO_DEBUG_NETWORKING
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>A development build loads your Litro dev server from this network.</string>
#endif
</dict>
</plist>
