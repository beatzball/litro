{
  "name": "litro-workspace",
  "private": true,
  "scripts": {
    "clean": "pnpm dlx rimraf node_modules \"packages/*/node_modules\" \"packages/*/dist\" \"playground*/node_modules\" \"playground*/dist\" \"docs/node_modules\" \"docs/dist\" \"docs-ssr/node_modules\" \"docs-ssr/dist\" .output .nitro \"playground*/server/stubs\" \"playground*/routes.generated.ts\" \"docs/server/stubs\" \"docs/routes.generated.ts\" \"docs-ssr/server/stubs\" \"docs-ssr/routes.generated.ts\" test-results playwright-report \"e2e/test-results\" \"**/*.tsbuildinfo\"",
    "setup": "pnpm install && pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build && pnpm install",
    "dev": "pnpm --filter playground dev",
    "dev:portless": "pnpm --filter playground dev:portless",
    "build": "pnpm --filter playground build",
    "preview": "pnpm --filter playground preview",
    "preview:portless": "pnpm --filter playground preview:portless",
    "dev:11ty": "pnpm --filter playground-11ty dev",
    "dev:11ty:portless": "pnpm --filter playground-11ty dev:portless",
    "build:11ty": "pnpm --filter playground-11ty build",
    "preview:11ty": "pnpm --filter playground-11ty preview",
    "preview:11ty:portless": "pnpm --filter playground-11ty preview:portless",
    "prepare:11ty": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:starlight": "pnpm --filter playground-starlight dev",
    "dev:starlight:portless": "pnpm --filter playground-starlight dev:portless",
    "build:starlight": "pnpm --filter playground-starlight build",
    "preview:starlight": "pnpm --filter playground-starlight preview",
    "preview:starlight:portless": "pnpm --filter playground-starlight preview:portless",
    "prepare:starlight": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:fast": "pnpm --filter playground-fast dev",
    "dev:fast:portless": "pnpm --filter playground-fast dev:portless",
    "build:fast": "pnpm --filter playground-fast build",
    "preview:fast": "pnpm --filter playground-fast preview",
    "preview:fast:portless": "pnpm --filter playground-fast preview:portless",
    "prepare:fast": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:elena": "pnpm --filter playground-elena dev",
    "dev:elena:portless": "pnpm --filter playground-elena dev:portless",
    "build:elena": "pnpm --filter playground-elena build",
    "preview:elena": "pnpm --filter playground-elena preview",
    "preview:elena:portless": "pnpm --filter playground-elena preview:portless",
    "prepare:elena": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:starlight-fast": "pnpm --filter playground-starlight-fast dev",
    "dev:starlight-fast:portless": "pnpm --filter playground-starlight-fast dev:portless",
    "build:starlight-fast": "pnpm --filter playground-starlight-fast build",
    "preview:starlight-fast": "pnpm --filter playground-starlight-fast preview",
    "preview:starlight-fast:portless": "pnpm --filter playground-starlight-fast preview:portless",
    "prepare:starlight-fast": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:starlight-elena": "pnpm --filter playground-starlight-elena dev",
    "dev:starlight-elena:portless": "pnpm --filter playground-starlight-elena dev:portless",
    "build:starlight-elena": "pnpm --filter playground-starlight-elena build",
    "preview:starlight-elena": "pnpm --filter playground-starlight-elena preview",
    "preview:starlight-elena:portless": "pnpm --filter playground-starlight-elena preview:portless",
    "prepare:starlight-elena": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:docs": "pnpm --filter @beatzball/litro-docs dev",
    "dev:docs:portless": "pnpm --filter @beatzball/litro-docs dev:portless",
    "build:docs": "pnpm --filter @beatzball/litro-docs build",
    "preview:docs": "pnpm --filter @beatzball/litro-docs preview",
    "preview:docs:portless": "pnpm --filter @beatzball/litro-docs preview:portless",
    "prepare:docs": "pnpm --filter @beatzball/litro-router build && pnpm --filter @beatzball/litro build",
    "dev:docs-ssr": "pnpm --filter @beatzball/litro-docs-ssr dev",
    "dev:docs-ssr:portless": "pnpm --filter @beatzball/litro-docs-ssr dev:portless",
    "build:docs-ssr": "pnpm --filter @beatzball/litro-docs-ssr build",
    "preview:docs-ssr": "pnpm --filter @beatzball/litro-docs-ssr preview",
    "preview:docs-ssr:portless": "pnpm --filter @beatzball/litro-docs-ssr preview:portless",
    "bench": "pnpm --filter @beatzball/litro-benchmarks bench",
    "bench:quick": "pnpm --filter @beatzball/litro-benchmarks bench:quick",
    "bench:cross": "pnpm --filter @beatzball/litro-benchmarks bench:cross && pnpm bench:update-readme",
    "bench:full": "pnpm --filter @beatzball/litro-benchmarks bench:full",
    "bench:hn": "pnpm --filter @beatzball/litro-benchmarks bench:hn",
    "bench:hn:full": "pnpm --filter @beatzball/litro-benchmarks bench:hn:full",
    "bench:all": "pnpm --filter @beatzball/litro-benchmarks bench:all && pnpm bench:update-readme",
    "bench:all:full": "pnpm --filter @beatzball/litro-benchmarks bench:all:full && pnpm bench:update-readme",
    "bench:update-readme": "node scripts/update-readme-bench.mjs",
    "dev:hn-mock-api": "pnpm --filter @beatzball/hn-mock-api dev",
    "dev:hn-litro": "pnpm --filter bench-hn-litro dev",
    "dev:hn-litro-fast": "pnpm --filter bench-hn-litro-fast dev",
    "dev:hn-litro-elena": "pnpm --filter bench-hn-litro-elena dev",
    "dev:hn-nextjs": "npm run dev --prefix benchmarks/apps/hn-nextjs",
    "dev:hn-nuxt": "npm run dev --prefix benchmarks/apps/hn-nuxt",
    "test": "pnpm --filter @beatzball/litro test && pnpm --filter @beatzball/litro-agent test",
    "test:docs": "pnpm --filter @beatzball/litro-docs-ui test && pnpm --filter @beatzball/litro-docs test",
    "test:e2e": "playwright test",
    "test:e2e:docs-ssr": "playwright test --project docs-ssr",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "lint": "tsc --noEmit -p packages/framework/tsconfig.json",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
  "check:e2e-isolation": "node scripts/check-e2e-isolation.mjs",
    "check:doc-refs:self-test": "node scripts/check-doc-refs.mjs --self-test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@playwright/test": "^1.48.0",
    "portless": "^0.10.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "tar": ">=7.5.11",
      "node-forge": ">=1.4.0",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "basic-ftp": ">=5.3.1",
      "brace-expansion": "^5.0.9",
      "fast-uri": "^4.1.3",
      "fflate": "^0.7.5",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "form-data": ">=4.0.6",
      "vite@5": "^6.4.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5xrq-8626-4rwp"
      ]
    }
  }
}
