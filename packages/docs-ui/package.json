{
  "name": "@beatzball/litro-docs-ui",
  "private": true,
  "type": "module",
  "sideEffects": ["./src/components/*.ts"],
  "exports": {
    "./src/*.js": {
      "source": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./src/components/*.js": {
      "source": "./src/components/*.ts",
      "default": "./src/components/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@beatzball/litro": "workspace:*",
    "@beatzball/litro-router": "workspace:*",
    "highlight.js": "^11.10.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.1.1",
    "rehype-stringify": "^10.0.1",
    "pathe": "^1.1.2",
    "@shoelace-style/shoelace": "^2.19.0",
    "h3": "^1.15.6"
  },
  "peerDependencies": {
    "lit": "^3.2.1",
    "@lit-labs/ssr": "^3.3.0",
    "@lit-labs/ssr-client": "^1.1.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
