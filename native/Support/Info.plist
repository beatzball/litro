<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both names come from the selected app's app.json, through the xcconfig
	     that native/scripts/select-app.sh writes. Nothing per-app is typed here. -->
	<key>CFBundleDisplayName</key>
	<string>$(LITRO_APP_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- The scene life cycle, which UIKit requires of an app built with a
	     current SDK. Without this an app delegate owning a UIWindow directly
	     only logs a fault today, and is terminated on launch by the SDK that
	     enforces it.

	     The delegate class is named with $(PRODUCT_MODULE_NAME) rather than
	     spelled out, because the module name follows PRODUCT_NAME, which
	     select-app.sh writes per app. A literal prefix here would resolve for
	     one app and silently fail to load for the next one, and a scene
	     delegate that fails to load is a black window with no error. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- One window. The shell is one web view filling the screen, so there
		     is nothing a second scene would show. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- App Transport Security blocks plain http, which includes the Vite dev
	     server a Litro app runs on during development. NSAllowsLocalNetworking
	     permits http to the local network and to localhost ONLY; it does not
	     weaken anything for a public host, so a shipped app that loads an https
	     start URL is unaffected. The broader NSAllowsArbitraryLoads is
	     deliberately not used: it would allow plain http anywhere and is a
	     question at store review. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
